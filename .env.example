# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/permupay
DB_SSL=false

# ─── Auth / Session ────────────────────────────────────────────────────────────
JWT_SECRET=troque-por-uma-string-aleatoria-de-64-chars
SESSION_SECRET=troque-por-outra-string-aleatoria-de-64-chars

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ─── Dominios ──────────────────────────────────────────────────────────────────
# Vitrine publica (shoop) — pagina inicial, marketplace, simulador, lista de desejos
VITE_STOREFRONT_URL=https://shoop.permupay.com.br

# Area logada (autopay) — painel, produtos, simulacoes, configuracoes
VITE_PANEL_URL=https://autopay.permupay.com.br

# ─── Identidade da aplicacao ───────────────────────────────────────────────────
VITE_APP_TITLE=PermuPay Vendas
VITE_APP_ID=permupay-vendas

# ─── S3 / Cloudflare R2 (Upload de Imagens de Produto) ────────────────────────
# Para AWS S3:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=permupay-images
S3_REGION=us-east-1
# S3_PUBLIC_BASE_URL=https://permupay-images.s3.amazonaws.com

# Para Cloudflare R2 (recomendado — sem custo de egress):
# AWS_ACCESS_KEY_ID=<r2-access-key>
# AWS_SECRET_ACCESS_KEY=<r2-secret-key>
# S3_BUCKET=permupay-images
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_BASE_URL=https://images.permupay.com.br

# Para MinIO local (desenvolvimento):
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET=permupay-images
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_BASE_URL=http://localhost:9000/permupay-images

# ─── Cadastro assistido por IA ─────────────────────────────────────────────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# Substitua pelo identificador confirmado no proxy/provedor de deploy.
LLM_MODEL_NAME=gemini-2.5-flash
