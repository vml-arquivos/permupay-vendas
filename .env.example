# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/permupay

# ─── Auth / Session ────────────────────────────────────────────────────────────
# Gerado automaticamente pelo SDK interno — não precisa configurar manualmente
# SESSION_SECRET=...

# ─── S3 / Cloudflare R2 (Upload de Imagens) ────────────────────────────────────
# Para AWS S3:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=permupay-images
S3_REGION=us-east-1

# Para Cloudflare R2 (recomendado — sem custo de egress):
# AWS_ACCESS_KEY_ID=<r2-access-key>
# AWS_SECRET_ACCESS_KEY=<r2-secret-key>
# S3_BUCKET=permupay-images
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_BASE_URL=https://images.seudominio.com

# Para MinIO local (desenvolvimento):
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET=permupay-images
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_BASE_URL=http://localhost:9000/permupay-images

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
